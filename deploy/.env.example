# Runtime file on louis. GitHub Environment `production` is the source of
# truth; this file is materialized at deploy time and is not committed.
#
# CMS_IMAGE_TAG selects the GHCR tag pulled by deploy/compose.yml (image-only;
# no on-server build). Prefer `latest` for Dokploy autoDeploy; pin a git sha
# when you need a specific revision. publish.yml pushes both :<sha> and :latest.

CMS_IMAGE_TAG=latest
APP_VERSION=
PUBLIC_URL=https://cms.sein.moe
ADMIN_ORIGIN=https://meme.sein.moe
STRAPI_ADMIN_BACKEND_URL=https://cms.sein.moe
ADMIN_COOKIE_SAMESITE=none
SERVE_ADMIN_PANEL=false
HOST=127.0.0.1
PORT=1337

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=cms
DATABASE_USERNAME=cms
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SCHEMA=public

CMS_MEDIA_PATH=/opt/cms/media
CMS_IMAGE_DIGEST=
ARCHIVE_ADMIN_EMAIL=
ARCHIVE_ADMIN_PASSWORD=
ARCHIVE_READ_TOKEN=
UPLOAD_SIZE_LIMIT=52428800
