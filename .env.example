HOST=127.0.0.1
PORT=1337
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
ENCRYPTION_KEY=tobemodified
JWT_SECRET=tobemodified

# Public API origin served by OpenResty on louis.
PUBLIC_URL=https://cms.sein.moe

# Admin SPA origin hosted on Vercel. Comma-separated if more than one.
ADMIN_URL=/
ADMIN_ORIGIN=https://meme.sein.moe
SERVE_ADMIN_PANEL=false
ADMIN_COOKIE_SAMESITE=none
ADMIN_RATE_LIMIT=true

# Baked into the Admin bundle at build time. Rebuild Admin when this changes.
STRAPI_ADMIN_BACKEND_URL=https://cms.sein.moe

# Reported by GET /health. Set to the Git SHA at deploy time.
APP_VERSION=

# Existing 1Panel PostgreSQL. Do not add a second database service.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=cms
DATABASE_USERNAME=cms
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SCHEMA=public

# Optional first-run seed for the Archive Administrator. Leave unset after the
# first successful login. Never commit the password.
ARCHIVE_ADMIN_EMAIL=
ARCHIVE_ADMIN_PASSWORD=

# Dedicated machine credential for GET /api/archive/v1/works/:archiveId.
# Required for the unbound Archive Read Contract seam. Never commit production values.
ARCHIVE_READ_TOKEN=

# Product upload cap (50 MiB). OpenResty client_max_body_size stays at 52m.
UPLOAD_SIZE_LIMIT=52428800

# Set at deploy time from the GHCR digest (reported by GET /health).
CMS_IMAGE_DIGEST=
