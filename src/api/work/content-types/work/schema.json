{
  "kind": "collectionType",
  "collectionName": "works",
  "info": {
    "singularName": "work",
    "pluralName": "works",
    "displayName": "Work",
    "description": "Historical club or member work with a stable Archive Identifier. Text lives in summary. Images attach through mediaItems."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "summary": {
      "type": "text"
    },
    "mediaItems": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "files"]
    },
    "archiveId": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 1
    }
  }
}
