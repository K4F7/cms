{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Strapi 5 content platform for the MemeBot Archive",
  "scripts": {
    "build": "strapi build",
    "build:admin": "node scripts/vercel-build.mjs",
    "console": "strapi console",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=180000 tests/*.test.mjs",
    "test:baseline": "node scripts/verify-baseline.mjs",
    "test:acceptance": "node scripts/verify-acceptance.mjs",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
  },
  "dependencies": {
    "@strapi/database": "5.52.0",
    "@strapi/plugin-users-permissions": "5.52.0",
    "@strapi/strapi": "5.52.0",
    "better-sqlite3": "12.8.0",
    "pg": "8.16.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "puppeteer-core": "24.23.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  }
}
